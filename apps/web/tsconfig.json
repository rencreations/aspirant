{
  "extends": "@aspirant/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@aspirant/ui/*": ["../../packages/ui/src/*"]
    },
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "tsBuildInfoFile": "./.next/cache/tsconfig.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "out"]
}
