{
  "model": "silverbolt",
  "schema": 1,
  "space": "glTF world: metres, Y up. The head faces +Z and the tail trails toward -Z. This is the space cameras.json is in. Bones hang on the scene root (no armature node) and every local transform is a plain armature-space transform.",
  "loader": {
    "three": "r186",
    "loader": "GLTFLoader",
    "decoders": "setMeshoptDecoder(MeshoptDecoder) from three/examples/jsm/libs/meshopt_decoder.module.js",
    "extensions": "EXT_meshopt_compression and KHR_mesh_quantization (both required), EXT_texture_webp (read by GLTFLoader with no plugin)",
    "notNeeded": "no DRACOLoader, no KTX2Loader",
    "materials": "MeshStandardMaterial; the build removes every KHR_materials_* extension so no MeshPhysicalMaterial appears"
  },
  "sizes": {
    "restLength": "about 3.5 m from the snout to the tail tip in the rest pose",
    "clipScale": "every source clip scales the whole dragon through D_she_root: 0.4 in the loops, 0.4 to 0.64 in interaction_03, 0.105 to 1 in flight_path"
  },
  "meshes": {
    "head": {
      "material": "silverbolt_body",
      "note": "armour, horns, jaw, tongue, wing blades. Opaque, double sided."
    },
    "eyes": {
      "material": "silverbolt_gem",
      "note": "the two eye almonds, skinned to sb_eye_L and sb_eye_R. Scale the eye bones in Y to blink. Emissive (the picture itself): drive material.emissiveIntensity for a glow."
    },
    "socket": {
      "material": "silverbolt_socket",
      "note": "a flat silver backing 2.5 mm behind each eye gem, on the head bone. It shows when the gem is squashed, so a shut eye reads as a lid and the head never shows through."
    },
    "crystals": {
      "material": "silverbolt_crystal",
      "note": "the big cheek crystals (cheek blades She_05 and She_06). Emissive, for a glow that follows a mood."
    },
    "ribbon": {
      "material": "silverbolt_ribbon",
      "note": "the flame tail and the body. Alpha blended, double sided."
    },
    "triangles": { "eyeTriangles": 28, "crystalTriangles": 54 }
  },
  "render": {
    "ribbon": {
      "transparent": true,
      "depthWrite": false,
      "side": "DoubleSide",
      "renderOrder": "draw it after the head (renderOrder 1 against 0); the loader already sets transparent and depthWrite false"
    },
    "head": "opaque; set frustumCulled = false on every skinned mesh (the quantised bounds are not the pose's)",
    "lighting": "the pictures are painted with the light in them: under MeshBasicMaterial with no lights the model reads well (silverbolt-angles.png), under MeshStandardMaterial with one environment map it reads better. Metalness and roughness are the exporter's defaults; envMapIntensity 0.6 to 1 against a bright ground."
  },
  "root": {
    "bone": "D_she_root",
    "note": "the body root. Clips key its translation in world metres and its uniform scale. Move and scale the dragon with a parent Group; drive this bone only if you play no clip."
  },
  "head": {
    "bone": "Bone02_She_01",
    "note": "turn this bone to look at things. Its children (jaw, cheek blades, crest, tongue, eyes) follow."
  },
