ct.","video":{"src":"video/films/film-ruby-and-angela-video-ruby-ruby-final/video.mp4","poster":"video/films/film-ruby-and-angela-video-ruby-ruby-final/poster.webp","w":2560,"h":1080,"dur":115.0,"captions":"video/films/film-ruby-and-angela-video-ruby-ruby-final/en.vtt"},"thumb":"video/films/film-ruby-and-angela-video-ruby-ruby-final/thumb.webp","backdrop":"video/films/film-ruby-and-angela-video-ruby-ruby-final/backdrop.webp","c":"#43515d","fps":25.0,"bytes":86849285},{"id":"film-ruby-and-angela-video-angela-angela-final","title":"A Friend","collection":"video","chars":["ruby","angela"],"pair":"ruby-angela","canon":"official","tags":["trailer","angela","oro","cyber cherubin"],"kind":"animated-trailer","desc":"Angela tells it from her side: the lab where Ruby made her, the Gardens, the daily training, and the word hurt, which she does not yet understand.","video":{"src":"video/films/film-ruby-and-angela-video-angela-angela-final/video.mp4","poster":"video/films/film-ruby-and-angela-video-angela-angela-final/poster.webp","w":2560,"h":1080,"dur":92.48,"captions":"video/films/film-ruby-and-angela-video-angela-angela-final/en.vtt"},"thumb":"video/films/film-ruby-and-angela-video-angela-angela-final/thumb.webp","backdrop":"video/films/film-ruby-and-angela-video-angela-angela-final/backdrop.webp","c":"#637992","fps":25.0,"bytes":56171744},{"id":"film-ruby-and-angela-video-trailer-trailer-final","title":"Awakening","collection":"video","chars":["ruby","angela","fanny","layla"],"pair":"ruby-angela","canon":"official","tags":["trailer","cinematic","dawnbreak"],"kind":"animated-trailer","desc":"On Planet Dawnbreak, androids from Planet Oro attack under Angela's lead. Ruby, who opposes the conquest, fights to awaken the android she once called her friend.","video":{"src":"video/films/film-ruby-and-angela-video-trailer-trailer-final/video.mp4","poster":"video/films/film-ruby-and-angela-video-trailer-trailer-final/poster.webp","w":2560,"h":1080,"dur":200.72,"captions":"video/films