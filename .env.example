# Copy to .env.local for local overrides. Only NEXT_PUBLIC_* values reach the browser bundle.

# Public origin of the deployed site (used for canonical URLs, sitemap, robots, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave empty when the site is served from a domain root (custom domain / org site / container).
# Set to "/repo-name" only for a GitHub *project* page, e.g. https://org.github.io/repo-name
BASE_PATH=
