{
  "CORSRules": [
    {
      "AllowedOrigins": [
        "https://aspirant.cc",
        "https://www.aspirant.cc",
        "http://localhost:3000",
        "http://localhost:3100",
        "http://localhost:3190"
      ],
      "AllowedMethods": ["GET", "HEAD"],
      "AllowedHeaders": ["Range", "If-Range", "If-None-Match", "If-Modified-Since"],
      "ExposeHeaders": ["Content-Length", "Content-Range", "Accept-Ranges", "ETag", "Content-Type"],
      "MaxAgeSeconds": 86400
    }
  ]
}
