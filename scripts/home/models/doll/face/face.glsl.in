// The doll's face, drawn in the doll's own material.
//
// THIS FILE IS THE SOURCE of face.glsl: `node scripts/home/models/doll/face/build-face.cjs` fills in the
// parameter macros from params.json and writes face.glsl. Edit this one.
//
// How it fits. The doll's body is one MeshStandardMaterial (the maps of doll.glb). The face triangles
// carry the vertex attribute `_face` = 1 (loaded by GLTFLoader as `_face`). The painted face was taken
// out of the maps, so the base colour is clean skin there. This chunk draws the eyes, the brows,
// the mouth, the tears and the rest over that base, in the fragment shader, in the head's own bind
// space (`vBind = position`, the position before the skin), so it turns and bends with the head, the hair
// hides it exactly (hair triangles have `_face` = 0) and nothing is a second mesh.
//
//   onBeforeCompile(shader):
//     shader.uniforms.uFaceF = { value: Float32Array(56) };       // params.json order
//     shader.uniforms.uFaceFrame = { value: Vector4(cx, cy, scale, roll) };
//     shader.uniforms.uIrisL = { value: Color(0xd9262f) }; uIrisR (0x5cbcf2); uInk (0x1d0f1d)
//     vertexShader:   replace '#include <common>'         by '#include <common>\n' + VERTEX_HEAD
//                     replace '#include <begin_vertex>'   by '#include <begin_vertex>\n' + VERTEX_BODY
//     fragmentShader: replace '#include <common>'         by '#include <common>\n' + FRAGMENT_HEAD
//                     replace '#include <map_fragment>'   by '#include <map_fragment>\n' + FRAGMENT_MAP
//   `// @section NAME` lines split this file into those four strings.
//
// Units. Face space is levelled on the line of the eyes, its unit is 0.1 m (uFaceFrame.z), its middle
// is the middle of the eyes (uFaceFrame.xy, bind metres) and `roll` is the angle of that line. Both
// eyes are drawn in a frame of their own where +x is outward, so one function draws both.
//
// Lines never get thinner than one pixel: every stroke has a floor taken from fwidth.

// @section vertex-head
attribute float _face;
varying vec3 vBind;
varying float vFace;

// @section vertex-body
vBind = position;
vFace = _face;

// @section fragment-head
varying vec3 vBind;
varying float vFace;
uniform float uFaceF[56];
uniform vec4 uFaceFrame;
uniform vec3 uIrisL;
uniform vec3 uIrisR;
uniform vec3 uInk;

//@PARAMS

const float EYE_X = 1.9177;
const vec2 MOUTH_AT = vec2(-0.155, -1.40);
const vec3 SCLERA = vec3(0.98, 0.97, 0.98);
const vec3 TONGUE = vec3(0.93, 0.36, 0.45);
const vec3 INSIDE = vec3(0.30, 0.04, 0.10);
const vec3 TEAR = vec3(0.62, 0.84, 1.0);
const vec3 HEART = vec3(0.92, 0.18, 0.31);
const vec3 SPARK = vec3(1.0, 0.70, 0.08);

float gPx;

float gCoverage(float d, float w) {
  float r = max(w, gPx * 0.85);
  float e = gPx * 0.7;
  return 1.0 - smoothstep(-e, e, d - r);
}

float gFill(float d) {
  return 1.0 - smoothstep(-gPx * 0.7, gPx * 0.7, d);
}

// 1 below a and fading to 0 at b, whichever is larger (smoothstep needs edge0 < edge1).
float gDown(float a, float b, float x) {
  return 1.0 - smoothstep(min(a, b), max(a, b), x);
}

float gDot2(vec2 v) {
  return dot(v, v);
}

float gSeg(vec2 p, vec2 a, vec2 b) {
  vec2 pa = p - a;
  vec2 ba = b - a;
  float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-6), 0.0, 1.0);
  return length(pa - ba * h);
}

// A line that is thick at a and thin at b: the distance to it, shrunk along its length.
float gSpike(vec2 p, vec2 a, vec2 b, float wa, float wb) {
  vec2 pa = p - a;
  vec2 ba = b - a;
  float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-6), 0.0, 1.0);
  return length(pa - ba * h) - mix(wa, wb, h);
}

float gEllipse(vec2 p, vec2 r) {
  // A cheap signed distance to an ellipse, good enough close to its edge.
  float k0 = length(p / r);
  float k1 = length(p / (r * r));
  return k0 * (k0 - 1.0) / max(k1, 1e-5);
}

// An arc of radius ra opening downward (the ends lower than the middle is `smile`; this one is the cap, ^).
float gArc(vec2 p, float ra, float halfAngle) {
  p.x = abs(p.x);
  vec2 sc = vec2(sin(halfAngle), cos(halfAngle));
  return (sc.y * p.x > sc.x * p.y) ? length(p - sc * ra) : abs(length(p) - ra);
}

float gHeartD(vec2 p) {
  p.x = abs(p.x);
  if (p.y + p.x > 1.0) return sqrt(gDot2(p - vec2(0.25, 0.75))) - 0.35355;
  return sqrt(min(gDot2(p - vec2(0.0, 1.0)), gDot2(p - 0.5 * max(p.x + p.y, 0.0)))) * sign(p.x - p.y);
}

float gSpiralD(vec2 p, float reach, float turn) {
  float r = length(p);
  float a = atan(p.y, p.x) + turn;
  float b = reach / 2.3;
  float d = abs(mod(r - b * a / 6.2831853, b) - b * 0.5) - b * 0.21;
  return max(d, r - reach);
}

float gStarD(vec2 p, float r) {
  // A four point sparkle: the inside of a concave diamond.
  p = abs(p);
  return pow(p.x / r, 0.6) + pow(p.y / r, 0.6) - 1.0;
}

float gDrop(vec2 p) {
  // A tear drop, tip up: a capsule that thins to a point.
  return gSpike(p, vec2(0.0, -0.14), vec2(0.0, 0.40), 0.17, 0.005);
}

vec2 gRot(vec2 p, float a) {
  float c = cos(a);
  float s = sin(a);
  return vec2(c * p.x + s * p.y, -s * p.x + c * p.y);
}

// One eye. q is in the eye's frame (+x outward, +y up), in units of 0.1 m, the eye's middle at 0.
// Returns the colour and, in w, how much of the pixel it covers. `lens` is the iris colour.
vec4 gEye(vec2 q, float open, float slant, float lowLid, float size, vec3 lens, float blink, vec2 look, float pupilScale) {
  vec2 e = q / size;
  float oe = max(open * (1.0 - blink), 0.0);
  float shear = e.y - slant * 0.30 * e.x;
  // Shut: the closed eye is a line, drawn apart and faded in as the eye closes.
  float closed = 1.0 - smoothstep(0.04, 0.30, oe);
  float b = 0.90 * max(oe, 0.001);
  float shape = gEllipse(vec2(e.x, shear), vec2(1.16, b));
  float floorY = mix(-b, -0.05 * b, lowLid);
  shape = max(shape, floorY - shear);
  float inside = gFill(shape * size);

  vec3 col = SCLERA;
  // The white of the eye is shaded under the upper lid and toward the corners.
  col *= mix(0.80, 1.0, gDown(b, -0.1, shear));
  col = mix(col, col * vec3(0.93, 0.94, 1.0), smoothstep(0.2, 1.1, abs(e.x)));

  // The iris: a crystal, lighter in the middle, a dark ring at the edge.
  vec2 ic = e - look * vec2(0.30, 0.20) - vec2(0.0, 0.03);
  float r = length(ic);
  float R = 0.83;
  vec3 inner = lens * 1.25 + 0.05;
  vec3 rim = lens * 0.42;
  vec3 iris = mix(inner, lens, smoothstep(0.0, 0.62, r));
  iris = mix(iris, rim, smoothstep(0.55, 0.83, r));
  iris += 0.18 * gDown(0.0, 0.7, length(ic - vec2(0.18, -0.2))) * vec3(1.0, 0.85, 0.85);
  float irisA = gFill((r - R) * size);
  float pr = 0.30 * pupilScale;
  float pupilA = gFill((length(ic * vec2(1.0, 0.85)) - pr) * size);
  iris = mix(iris, lens * 0.18, pupilA);
  col = mix(col, iris, irisA);
  // Highlights: a big one up and left, a small one down and right.
  float h1 = gFill((length(ic - vec2(-0.27, 0.30)) - 0.19) * size);
  float h2 = gFill((length(ic - vec2(0.28, -0.32)) - 0.085) * size);
  col = mix(col, vec3(1.0), clamp(h1 + h2, 0.0, 1.0) * irisA * clamp(F_glint, 0.0, 1.0));

  // The upper lash: a heavy line along the top of the eye, a flick at the outer corner, a fine
  // line under the eye.
  float edge = abs(shape);
  float lashW = 0.15 * size * (1.0 + 0.5 * max(slant, 0.0)) * F_lash;
  float top = smoothstep(-0.05, 0.25, shear);
  float lashA = gCoverage(edge * size, lashW * 0.5) * top;
  float flick = gSpike(vec2(e.x, shear), vec2(1.02, 0.18 * b + 0.02), vec2(1.62, -0.34 * b - 0.06), 0.15 * size * F_lash, 0.012);
  lashA = max(lashA, gFill(flick * size));
  float lower = gCoverage(edge * size, 0.028) * (1.0 - smoothstep(-0.30, -0.05, shear)) * 0.8;
  lashA = clamp(max(lashA, lower), 0.0, 1.0);
  col = mix(col, uInk, lashA);
  float a = max(inside, lashA);

  // The closed eye: an arc like a smile, with the same flick.
  vec2 c = vec2(e.x, e.y - 0.20 - slant * 0.15 * e.x);
  float arc = max(abs(gEllipse(c, vec2(1.0, 0.34))), c.y);
  arc = max(arc, abs(c.x) - 1.04);
  float cl = gCoverage(arc * size, 0.075 * size);
  float cf = gFill(gSpike(vec2(e.x, e.y - slant * 0.15 * e.x), vec2(0.98, -0.12), vec2(1.55, -0.34), 0.13 * size, 0.012) * size);
  cl = max(cl, cf);
  vec4 openEye = vec4(col, a);
  vec4 closedEye = vec4(uInk, cl);
  return mix(openEye, closedEye, closed);
}

// The glyph eyes, each in the eye's frame. Returns (alpha) and writes the colour.
float gGlyph(int which, vec2 q, float size, out vec3 colour) {
  vec2 e = q / size;
  colour = uInk;
  if (which == 0) { // ^ : an arc
    return gCoverage(gArc(e + vec2(0.0, 0.55), 0.78, 1.0) * size, 0.12 * size);
  }
  if (which == 1) { // > outward: the apex looks to the nose
    vec2 a = vec2(0.55, 0.52);
    vec2 m = vec2(-0.50, 0.0);
    vec2 c = vec2(0.55, -0.52);
    float d = min(gSeg(e, a, m), gSeg(e, m, c));
    return gCoverage(d * size, 0.105 * size);
  }
  if (which == 2) { // spiral
    colour = uInk;
    return gCoverage(gSpiralD(e, 1.0, F_time) * size, 0.0);
  }
  if (which == 3) { // heart, the point down
    colour = HEART;
    vec2 h = vec2(e.x, e.y + 0.55) / 1.15;
    return gFill(gHeartD(h) * 1.15 * size);
  }
  if (which == 4) { // sparkle
    colour = SPARK;
    return gFill(gStarD(e, 0.95) * 0.5 * size);
  }
  if (which == 5) { // X
    float d = min(gSeg(e, vec2(-0.55, 0.55), vec2(0.55, -0.55)), gSeg(e, vec2(-0.55, -0.55), vec2(0.55, 0.55)));
    return gCoverage(d * size, 0.11 * size);
  }
  if (which == 6) { // a small dark dot
    float d = gEllipse(e, vec2(0.24, 0.30));
    return gFill(d * size);
  }
  // 7: a flat line with a flick, the sleepy eye
  float d = gSeg(e, vec2(-1.0, -0.06), vec2(1.0, -0.06));
  float f = gSpike(e, vec2(0.9, -0.06), vec2(1.5, -0.30), 0.11 * size, 0.012);
  return max(gCoverage(d * size, 0.085 * size), gCoverage(f * size, 0.0));
}

// A brow in the eye's frame: a thick, tapered line.
float gBrow(vec2 q, float y, float ang, float curve, float thick) {
  float t = max(thick, 0.0);
  vec2 a = vec2(-0.98, 1.22 + 0.30 * y - 0.46 * ang);
  vec2 c = vec2(0.98, 1.22 + 0.30 * y + 0.30 * ang);
  vec2 m = mix(a, c, 0.5) + vec2(0.0, 0.26 * curve);
  float d = min(gSpike(q, a, m, 0.17 * t, 0.15 * t), gSpike(q, m, c, 0.15 * t, 0.06 * t));
  return gCoverage(d, 0.0);
}

// The mouth. m is in the mouth's frame (+y up), in units of 0.1 m. Writes the colour.
vec4 gMouth(vec2 m) {
  float W = 0.40 * F_mW;
  float open = F_mOpen;
  vec3 col = uInk;
  float alpha = 0.0;

  // Line mouths: one line whose bend blends frown, dash and smile.
  float wl = clamp(F_mDash + F_mSmile + F_mFrown, 0.0, 1.0);
  float bend = (F_mSmile - F_mFrown) / max(F_mDash + F_mSmile + F_mFrown, 1e-3) + F_mCurve;
  float x = clamp(m.x / W, -1.0, 1.0);
  float lineY = -bend * 0.55 * W * (1.0 - x * x) + 0.12 * W * bend;
  float dl = abs(m.y - lineY) - 0.0;
  dl = max(dl, abs(m.x) - W);
  alpha = max(alpha, gCoverage(dl, 0.052) * wl);

  // Wavy.
  float wy = 0.075 * sin(m.x * 14.0 / max(F_mW, 0.5) + 0.5);
  float dw = max(abs(m.y - wy) , abs(m.x) - W * 0.95);
  alpha = max(alpha, gCoverage(dw, 0.052) * F_mWavy);

  // A cat mouth: two small arcs.
  float cat = min(gArc(vec2(abs(m.x) - 0.15 * F_mW, 0.04 - m.y) * vec2(1.0, 1.0), 0.15 * F_mW, 1.2), 1e3);
  alpha = max(alpha, gCoverage(cat, 0.046) * F_mCat);

  // A pout: a small round pucker.
  float po = abs(length(m * vec2(1.0, 1.1)) - 0.11) ;
  alpha = max(alpha, gCoverage(po, 0.045) * F_mPout);

  // Open mouths: D (flat top, round bottom), O (round), scream (large, round).
  float dH = 0.10 + 0.50 * open * W;
  float dd = max(length(m * vec2(1.0, W / max(dH, 0.05)) - vec2(0.0, 0.0)) - W, m.y - 0.02);
  float oo = gEllipse(m, vec2(0.10 + 0.05 * open, 0.10 + 0.16 * open));
  float sc = gEllipse(m - vec2(0.0, -0.18 * open), vec2(0.46 * F_mW, 0.18 + 0.40 * open));
  float fillA = max(gFill(dd) * F_mD, max(gFill(oo) * F_mO, gFill(sc) * F_mScream));
  vec3 inner = INSIDE;
  // Teeth: a white band under the top edge of a D or scream mouth.
  float topY = mix(0.02, 0.18 * open + 0.1, F_mScream);
  float teethA = fillA * F_teeth * smoothstep(0.0, 0.02, topY - m.y) * gDown(0.10, 0.18, topY - m.y);
  inner = mix(inner, vec3(1.0), teethA);
  // Tongue: the lower part of the open mouth.
  float tg = gEllipse(m - vec2(0.0, -0.20 - 0.12 * open), vec2(0.60 * W, 0.15 + 0.14 * open));
  float tongueA = gFill(tg) * max(F_mTongue, F_mScream * 0.9 + F_mD * 0.45) * fillA;
  inner = mix(inner, TONGUE, tongueA);
  // The outline of an open mouth.
  float ring = max(gCoverage(abs(min(min(dd, oo), sc)) , 0.045), 0.0);
  col = inner;
  float inA = fillA;
  float outlineA = ring * clamp(F_mD + F_mO + F_mScream, 0.0, 1.0);
  vec3 outCol = mix(col, uInk, outlineA);
  alpha = max(alpha, max(inA, outlineA));
  col = mix(uInk, outCol, step(0.001, max(inA, outlineA)));
  // Fangs: two small triangles under the line.
  vec2 fa = vec2(abs(m.x) - 0.55 * W, m.y - lineY);
  float fang = max(max(abs(fa.x) * 2.2 + fa.y * 1.0, 0.0) - 0.07, -(fa.y + 0.14));
  fang = max(fang, fa.y - 0.02);
  float fangA = gFill(fang) * F_mFang;
  col = mix(col, vec3(1.0), fangA);
  alpha = max(alpha, fangA);
  return vec4(col, alpha);
}

vec3 gFace(vec3 base, vec2 bind) {
  float s = uFaceFrame.z;
  vec2 p = gRot((bind - uFaceFrame.xy) / s, uFaceFrame.w);
  gPx = max(length(fwidth(p)) * 0.7071, 1e-4);
  vec3 col = base;

  // Cheeks: always a little rosy, more with `blush`; an angry face is red, a shocked one pale.
  float cheekL = exp(-gDot2((p - vec2(-EYE_X, -0.95)) * vec2(0.62, 1.0)) * 1.6);
  float cheekR = exp(-gDot2((p - vec2(EYE_X, -0.95)) * vec2(0.62, 1.0)) * 1.6);
  float cheek = max(cheekL, cheekR);
  col = mix(col, vec3(1.0, 0.56, 0.62), cheek * (0.10 + 0.50 * F_blush));
  float face = exp(-gDot2(p * vec2(0.26, 0.30)));
  col = mix(col, vec3(1.0, 0.33, 0.28) * col, 0.55 * F_flush * face);
  col = mix(col, mix(col, vec3(1.0, 1.0, 1.0), 0.55), F_shock * face);

  // Forehead lines of gloom.
  float lines = 0.0;
  for (int i = -1; i <= 1; i++) {
    float x = float(i) * 0.55;
    float d = abs(p.x - x - 0.18 * sin(p.y * 4.0)) ;
    lines = max(lines, gCoverage(d, 0.04) * smoothstep(1.55, 1.9, p.y) * gDown(2.6, 3.1, p.y));
  }
  col = mix(col, vec3(0.45, 0.30, 0.45), lines * 0.75 * F_gloom);

  // The eyes. The left eye is on the screen's left: its outward is -x.
  vec2 qL = vec2(-(p.x + EYE_X), p.y);
  vec2 qR = vec2(p.x - EYE_X, p.y);
  vec2 look = vec2(F_lookX, F_lookY);
  float glyphSum = F_gArc + F_gChevron + F_gSpiral + F_gHeart + F_gStar + F_gCross + F_gDot + F_gLine;
  float G = clamp(glyphSum, 0.0, 1.0);

  vec4 eL = gEye(qL, F_openL, F_slantL, F_lowLidL, F_sizeL, uIrisL, F_blinkL, vec2(-look.x, look.y), F_pupil);
  vec4 eR = gEye(qR, F_openR, F_slantR, F_lowLidR, F_sizeR, uIrisR, F_blinkR, look, F_pupil);
  // The look is in the screen's frame; the left eye's frame is mirrored, which the sign above undoes.
  col = mix(col, eL.rgb, eL.a * (1.0 - G));
  col = mix(col, eR.rgb, eR.a * (1.0 - G));
  // Glyphs.
  float gw[8];
  gw[0] = F_gArc; gw[1] = F_gChevron; gw[2] = F_gSpiral; gw[3] = F_gHeart;
  gw[4] = F_gStar; gw[5] = F_gCross; gw[6] = F_gDot; gw[7] = F_gLine;
  for (int i = 0; i < 8; i++) {
    if (gw[i] < 0.001) continue;
    vec3 gcL;
    vec3 gcR;
    float gaL = gGlyph(i, qL, F_sizeL, gcL);
    float gaR = gGlyph(i, qR, F_sizeR, gcR);
    col = mix(col, gcL, gaL * gw[i]);
    col = mix(col, gcR, gaR * gw[i]);
  }

  // Brows (they are dark, over the lids).
  float bL = gBrow(qL, F_browYL, F_browAngL, F_browCurve, F_browThick);
  float bR = gBrow(qR, F_browYR, F_browAngR, F_browCurve, F_browThick);
  col = mix(col, uInk, max(bL, bR));

  // Tears: a stream under each eye, blue-white with a light line in it.
  for (int side = 0; side < 2; side++) {
    vec2 q = side == 0 ? qL : qR;
    float amount = side == 0 ? F_tearsL : F_tearsR;
    if (amount < 0.001) continue;
    // A tear: a capsule that runs down from under the eye and thins a little, with a light line in it.
    vec2 top = vec2(0.15, -0.60);
    vec2 bot = vec2(0.15, -0.60 - 1.9 * amount);
    float stream = gSpike(q, top, bot, 0.20, 0.13);
    float a = gFill(stream);
    float hi = gCoverage(gSeg(q, top + vec2(-0.07, -0.12), bot + vec2(-0.05, 0.22)), 0.03) * a;
    vec3 tc = mix(TEAR, vec3(1.0), hi * 0.9);
    col = mix(col, tc, a * 0.92);
    col = mix(col, uInk, gCoverage(abs(stream), 0.02) * 0.30);
  }

  // The mouth, with its tilt and shift.
  vec2 mm = p - MOUTH_AT - vec2(F_mX * 0.45, F_mY * 0.35);
  mm = gRot(mm, F_mTilt * 0.5);
  vec4 mouth = gMouth(mm);
  col = mix(col, mouth.rgb, mouth.a);

  // A sweat drop at the temple.
  vec2 sp = (p - vec2(2.95, 1.35)) / 0.5;
  float sd = gDrop(sp) * 0.5;
  float sa = gFill(sd) * F_sweat;
  col = mix(col, TEAR, sa * 0.95);
  col = mix(col, uInk, gCoverage(abs(sd), 0.03) * 0.5 * F_sweat);
  col = mix(col, vec3(1.0), gFill((length(sp - vec2(-0.12, -0.08)) - 0.09) * 0.5) * F_sweat);
  return col;
}

// @section fragment-map
if (vFace > 0.5) {
  diffuseColor.rgb = gFace(diffuseColor.rgb, vBind.xy);
}
