{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // Repository scripts (asset pipeline, content builders, QA scans).
      "entry": ["scripts/**/*.{mjs,js,ts}"],
      "project": ["scripts/**/*.{mjs,js,ts}"],
    },
    "apps/web": {
      "entry": [
        "src/app/**/{page,layout,not-found,error,loading,template,default}.tsx",
        "src/app/**/{route,sitemap,robots,manifest}.ts",
        "e2e/**/*.{ts,mjs}",
        // Typed content layer: an API for the page features, consumed as pages land.
        "src/content/**/*.ts",
      ],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.{ts,mjs}"],
      "ignoreDependencies": [
        // Toolkit kept for page work (design brief): Motion for UI animation, cva for
        // variants, lucide icons. Remove an entry once a page imports it.
        "motion",
        "class-variance-authority",
        "lucide-react",
      ],
    },
    "packages/ui": {
      "entry": ["src/components/*.tsx", "src/lib/*.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "packages/config": {
      "entry": ["eslint/*.mjs"],
      // Referenced by name from the Prettier config's `plugins` array, which knip cannot follow.
      "ignoreDependencies": ["prettier-plugin-tailwindcss"],
      // tsconfig "plugins": [{ "name": "next" }] is an editor plugin, not an import.
      "ignoreUnresolved": ["next"],
    },
  },
}
