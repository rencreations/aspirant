{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // Repository scripts (asset pipeline, content builders, QA scans).
      "entry": ["scripts/**/*.{mjs,js,ts}"],
      "project": ["scripts/**/*.{mjs,js,ts}"],
      // The model builds' own pages run in a browser and take three from an import map.
      "ignore": [
        "scripts/about/drone/page/**",
        "scripts/about/tetra/page/**",
        "scripts/about/companions/page/**",
        "scripts/about/bunny/page/**",
        // The pages of the home scripts (the models' check pages, the drone and the doll's previews)
        // run in a browser and take three from an import map.
        "scripts/home/**/{page,preview}/**",
      ],
      "ignoreBinaries": ["ffmpeg"],
    },
    "apps/web": {
      "entry": [
        "src/app/**/{page,layout,not-found,error,loading,template,default}.tsx",
        "src/app/**/{route,sitemap,robots,manifest}.ts",
        "e2e/**/*.{ts,mjs}",
        // Typed content layer: an API for the page features, consumed as pages land.
        "src/content/**/*.ts",
      ],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.{ts,mjs}"],
      "ignoreDependencies": [
        // Toolkit kept for page work (design brief): cva for variants. Remove an entry once a
        // page imports it (lucide icons are used by the story's chapter morph).
        "class-variance-authority",
        // The old home was their only user (R3F stage, GSAP hook). The integrator removes both from
        // the catalog, the package file and the lockfile once the rebuilt home has landed.
        "@react-three/fiber",
        "@gsap/react",
      ],
    },
    "packages/ui": {
      "entry": ["src/components/*.tsx", "src/lib/*.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "packages/config": {
      "entry": ["eslint/*.mjs"],
      // Referenced by name from the Prettier config's `plugins` array, which knip cannot follow.
      "ignoreDependencies": ["prettier-plugin-tailwindcss"],
      // tsconfig "plugins": [{ "name": "next" }] is an editor plugin, not an import.
      "ignoreUnresolved": ["next"],
    },
  },
}
