{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["pnpm-workspace.yaml", ".npmrc", "tsconfig.json"],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.*", "!e2e/**", "!**/*.md"],
      "env": ["NEXT_PUBLIC_*", "SITE_URL", "BASE_PATH"],
      "passThroughEnv": ["NEXT_DIST_DIR"],
      "outputs": ["out/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "passThroughEnv": ["NEXT_DIST_DIR", "PORT"],
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
