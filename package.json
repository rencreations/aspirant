{
  "name": "aspirant",
  "version": "0.1.0",
  "private": true,
  "description": "Aspirant: static, interactive website monorepo (Next.js + pnpm workspaces).",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.28.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@aspirant/web",
    "build": "turbo run build",
    "start": "pnpm --filter @aspirant/web start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @aspirant/web test:e2e",
    "test:e2e:install": "pnpm --filter @aspirant/web exec playwright install --with-deps chromium",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm knip",
    "knip": "knip",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "sbom": "cdxgen -t pnpm --spec-version 1.6 -o sbom.cdx.json .",
    "docker:build": "docker build -t aspirant-web:local .",
    "docker:run": "docker run --rm -p 8080:8080 aspirant-web:local",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "husky",
    "assets": "node scripts/assets/build.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,mdx,css,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@aspirant/config": "workspace:*",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@cyclonedx/cdxgen": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "sharp": "^0.35.5",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
